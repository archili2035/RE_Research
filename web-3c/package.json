{
  "name": "re-research-web-3c",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/stamp-build.mjs",
    "build:portal": "npm run build -- --portal",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/check-playfield-layout.mjs && node tests/check-leon-browser.mjs && node tests/check-leon-v5-browser.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@types/three": "0.160.0",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
